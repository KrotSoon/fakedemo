<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 like FakeDemo.exe: runs on any Windows 10/11 without installing a runtime -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FakeDemoOverlay</AssemblyName>
    <ApplicationIcon>..\..\assets\FakeDemo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Reference Include="System.Management" />
    <Content Include="menu.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
